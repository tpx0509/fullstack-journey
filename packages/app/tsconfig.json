{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // composite：让这个包能被别的包用 references 引用，tsc -b 据此做增量构建
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src"],
  // 引用谁，tsc -b 就保证先构建谁。漏写一个，编译期就找不到它的 dist
  "references": [{ "path": "../core" }, { "path": "../utils" }]
}
